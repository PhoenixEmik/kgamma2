pkgname=kgamma2
pkgver=@VERSION@
pkgrel=1
pkgdesc='Per-monitor gamma adjustment for KDE Plasma Wayland'
arch=('x86_64')
url='https://github.com/PhoenixEmik/kgamma2'
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'CC-BY-SA-4.0' 'CC0-1.0')
depends=('kconfig' 'ki18n' 'kirigami' 'libkscreen' 'lcms2' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'extra-cmake-modules')
checkdepends=('desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKGAMMA2_VERSION="$pkgver"
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver"/LICENSES/* \
        -t "$pkgdir/usr/share/licenses/$pkgname/"
}
